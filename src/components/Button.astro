---
// Prism for the canon voices, pixel (Sixtyfour) for Relay and Inscription.
// Square is the framed option in any voice, in its nav face.
interface Props { label: string; href?: string; kind?: "prism" | "pixel" | "square"; pressed?: boolean }
const { label, href, kind = "prism", pressed = false } = Astro.props;
const cls = `ei-btn ei-btn--${kind}${pressed ? " is-pressed" : ""}`;
---
{href
  ? <a class={cls} href={href}><span class="ei-btn__label" data-text={label}>{label}</span></a>
  : <button class={cls} aria-pressed={pressed ? "true" : undefined}><span class="ei-btn__label" data-text={label}>{label}</span></button>}
