---
// A thin band of fine contour lines under a page title: the Rite Tec dissolve,
// drawn at about 1:1 so the displacement stays smooth instead of pixelated.
import { nextSuffix } from "../svg";

interface Props { lines?: number; seed?: number }
const { lines = 11, seed = 7 } = Astro.props;

const W = 1600, H = 48;
let s = seed;
const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
const center = Math.floor(lines / 2);
const paths = Array.from({ length: lines }, (_, i) => {
  const y = ((i + 0.5) * H) / lines;
  const pts = [0, 1, 2, 3].map(() => y + (rand() - 0.5) * 6);
  const cls = i === center ? "s3" : i % 3 === 1 ? "s2" : "s1";
  return { cls, d: `M-40 ${pts[0].toFixed(1)} C ${W * 0.3} ${pts[1].toFixed(1)}, ${W * 0.62} ${pts[2].toFixed(1)}, ${W + 40} ${pts[3].toFixed(1)}` };
});
const id = `stripe-${nextSuffix()}`;
---
<svg class="stripe" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
  <filter id={id} x="0" y="-30%" width="100%" height="160%">
    <feTurbulence type="fractalNoise" baseFrequency="0.0035 0.05" numOctaves="2" seed={seed}>
      <animate attributeName="baseFrequency" values="0.0035 0.05;0.005 0.07;0.0035 0.05" dur="24s" repeatCount="indefinite" />
    </feTurbulence>
    <feDisplacementMap in="SourceGraphic" scale="7" xChannelSelector="R" yChannelSelector="G" />
  </filter>
  <g filter={`url(#${id})`}>{paths.map((p) => <path class={p.cls} d={p.d} />)}</g>
</svg>

<style>
  .stripe { display: block; width: 100%; height: 48px; overflow: hidden; }
  .stripe path { fill: none; stroke-width: .75; vector-effect: non-scaling-stroke; }
  .stripe .s1 { stroke: var(--field-3); opacity: .8; }
  .stripe .s2 { stroke: var(--trace); opacity: .4; }
  .stripe .s3 { stroke: var(--signal); opacity: .85; }
  @media (prefers-reduced-motion: reduce) { .stripe animate { display: none; } }
</style>
