---
// The pieces on the Eidolon page: one content file each in content/pieces, newest first.
// Each piece sits below a hairline with its photo strip.
interface Photo { src: string; w: number; h: number; alt: string }
interface Piece { title: string; year: number; with?: string; order: number; photos: Photo[] }
const files = import.meta.glob<{ frontmatter: Piece }>("../content/pieces/*.md", { eager: true });
const pieces = Object.values(files).map((f) => f.frontmatter).sort((a, b) => a.order - b.order);
---
<div class="pc">
  {pieces.map((p) => (
    <section class="pc-piece">
      <p class="pc-meta"><span>{p.year}</span>{p.with && <span>with {p.with}</span>}</p>
      <h3 class="pc-title">{p.title}</h3>
      <div class="pc-strip" role="list">
        {p.photos.map((ph) => (
          <a role="listitem" href={ph.src} target="_blank" rel="noopener"><img src={ph.src} width={ph.w} height={ph.h} style={`--h:${ph.h}px`} alt={ph.alt} loading="lazy" decoding="async" /></a>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .pc-piece { padding-top: 24px; border-top: 1px solid var(--line); }
  .pc-piece + .pc-piece { margin-top: 48px; }
  .pc-meta { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; font: 500 12px/16px var(--v-nav); letter-spacing: var(--v-nav-ls); text-transform: uppercase; color: var(--ink-muted); }
  .pc-meta span:first-child { color: var(--trace); }
  .doc .pc-title, .pc-title { margin: 16px 0 0; font: var(--v-sub-w) clamp(24px, 1vw + 19px, 36px)/1.1 var(--v-sub); letter-spacing: normal; text-transform: none; color: var(--bone); }
  /* A strip of photos at one height that scrolls sideways inside itself; the page never does. */
  .pc-strip { display: flex; gap: 8px; margin-top: 24px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin; padding-bottom: 8px; }
  .pc-strip a { flex: none; scroll-snap-align: start; }
  .pc-strip img { display: block; height: min(clamp(220px, 28vw, 400px), var(--h)); width: auto; } /* never upscaled */
  .pc-strip a:hover img { opacity: .82; }
</style>
