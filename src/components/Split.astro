---
// Two halves side by side (stacked on a phone): day on the left, night on the right.
// Each half sets its own palette and voice; fill the "day" and "night" slots with SplitHalf.
import Fog from "./Fog.astro";

interface Half { theme: string; voice: string; fog?: "spread" | "storm" | "contour" | "rune" }
interface Props { day: Half; night: Half }
const { day, night } = Astro.props;
---
<div class="ei-split">
  <section class="day" data-theme={day.theme} data-voice={day.voice}>
    {day.fog && <Fog kind={day.fog} />}
    <slot name="day" />
  </section>
  <section class="night" data-theme={night.theme} data-voice={night.voice}>
    {night.fog && <Fog kind={night.fog} />}
    <slot name="night" />
  </section>
</div>
