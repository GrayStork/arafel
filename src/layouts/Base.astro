---
import "../../design-system/eidolon-v1/css/eidolon.css";
import "../styles/site.css";
import NetBar from "../components/NetBar.astro";
import Foot from "../components/Foot.astro";
import type { WorldId } from "../worlds";

interface Props {
  title: string;
  description?: string;
  theme: string;
  voice: string;
  world?: WorldId;
  sections?: { label: string; href: string; current?: boolean }[];
  noindex?: boolean;
  og?: string; // preview image in /og, defaults to the world's
}

const { title, description, theme, voice, world, sections = [], noindex = false, og } = Astro.props;
// Link preview (Facebook, messengers, search): one image per page in its own palette and voice.
const ogName = og ?? (world === "rite-tec" || world === "eidolon" || world === "architect" ? world : "home");
const ogImage = new URL(`/og/${ogName}.png`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// Cloudflare Web Analytics: no cookies, production builds only. The site token is public; empty turns it off.
const analyticsToken = "f4956caf3c7f48d4ba248aa7427d020d";
---
<!doctype html>
<html lang="en" data-theme={theme} data-voice={voice}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arafel" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {import.meta.env.PROD && analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}
  </head>
  <body>
    <div class="ei-page">
      <NetBar world={world} sections={sections} />
      <slot />
      <Foot world={world} />
    </div>
  </body>
</html>

<style is:global>
  body { margin: 0; background: var(--abyss); }
  /* The kit's overflow: hidden breaks position: sticky; clip trims the same overflow without it (ds:proposal 002). */
  .ei-page { overflow: clip; }
</style>
