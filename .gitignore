# Build output and dependencies
node_modules/
dist/
.astro/
public/kit/

# Never committed
*.zip
__pycache__/
.claude/

# Process docs stay local
CLAUDE.md
HANDOFF.md
docs/

# Old HTML sketches, replaced by src/
sites/

# Design system: only what the site serves is public.
# The generator, brand book, canon, partials and templates stay local.
/design-system/*
!/design-system/eidolon-v1/
/design-system/eidolon-v1/*
!/design-system/eidolon-v1/css/
!/design-system/eidolon-v1/img/
# Photos are site assets: all of them are public.
# Faces: list each one a page uses (src/worlds.ts and src/components/NetBar.astro).
/design-system/eidolon-v1/img/faces/*
!/design-system/eidolon-v1/img/faces/eidolon-axis.webp
!/design-system/eidolon-v1/img/faces/eidolon-axis-arch.webp
!/design-system/eidolon-v1/img/faces/eidolon-club.webp
!/design-system/eidolon-v1/img/faces/eidolon-rite.webp

# Text-editing guide and log stay local
src/content/AGENTS.md
src/content/NOTES.md

# Local media, not part of the site. /video/ holds cuts in work and clips that live only on YouTube;
# a video moves (never copies) to public/video/ once it is approved and placed on a page.
*.wav
*.mov
/video/

